# Database: SQLite by default. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg2://dentaliq:secret@localhost:5432/dentaliq
# (and `pip install psycopg2-binary`)
DATABASE_URL=sqlite:///./dental_iq.db

# JWT - CHANGE THIS in any shared deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
