# ---------------------------------------------------------------------------
# Dental-IQ backend settings. Copy to backend/.env (never commit the real file).
# ---------------------------------------------------------------------------

# development | production
#   production: requires a strong JWT_SECRET, explicit CORS origins, and never
#   auto-creates tables (run `alembic upgrade head`; Docker does this for you).
APP_ENV=development

# Database: SQLite by default. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg2://dentaliq:secret@localhost:5432/dentaliq
DATABASE_URL=sqlite:///./dental_iq.db

# Create missing tables at start-up (development only; ignored in production).
AUTO_CREATE_TABLES=true

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to get a random per-process secret (sessions reset on restart).
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Failed-login protection (per email + client IP)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Only behind a trusted reverse proxy (e.g. the Docker nginx): read client IP from X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Comma-separated list of allowed frontend origins (no '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
