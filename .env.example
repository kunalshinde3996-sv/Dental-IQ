# Docker Compose settings. Copy to .env (never commit the real file).
# For local development without Docker, see backend/.env.example instead.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Required. Any strong password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=

# Optional
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080
JWT_EXPIRE_MINUTES=480

# Only if image builds fail with CERTIFICATE_VERIFY_FAILED (corporate proxy / antivirus HTTPS
# scanning): path to that root CA in PEM format. Used at build time only.
# EXTRA_CA_CERT=/path/to/root-ca.pem
